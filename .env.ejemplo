# Plantilla del .env. Copiar a `.env` y rellenar.
#
#   cp .env.ejemplo .env
#
# El .env REAL nunca se sube: está en .gitignore desde el primer commit, y se
# verificó que jamás estuvo en el historial de git.
#
# ---------------------------------------------------------------------------
# POR QUÉ ESTE ARCHIVO EXISTE, Y POR QUÉ NO HAY UN "RESPALDO" DEL .env
# ---------------------------------------------------------------------------
# Las cuatro credenciales son REGENERABLES. Ninguna es un dato único que se
# pierda para siempre: si el disco muere, se emiten de nuevo en dos minutos
# siguiendo las instrucciones de abajo.
#
# Por eso no hay una copia del .env en otra carpeta: una copia en el mismo
# disco muere con el disco, y una copia en cualquier otro lado es un sitio más
# desde donde se puede filtrar. Lo que sí vale la pena es (a) saber de dónde
# sale cada una, que es lo que documenta este archivo, y (b) tenerlas en un
# gestor de contraseñas si molesta rehacerlas.
#
# Si alguna se filtra, REGENERARLA es la respuesta correcta, no esconderla.
# ---------------------------------------------------------------------------


# --- Supabase --------------------------------------------------------------
# Proyecto: el mismo que usa Monitor LaLiga (compartido a propósito; las
# tablas de esports llevan prefijo dota_ o eslo_ para no chocar).
#
# Dónde: dashboard de Supabase > el proyecto > Settings > API
#   SUPABASE_URL              es la "Project URL". NO es un secreto: aparece
#                             en la propia página y no da acceso por sí sola.
#   SUPABASE_SERVICE_ROLE_KEY es la llave `service_role`. SÍ es un secreto,
#                             y de los serios: ignora RLS y puede leer y
#                             escribir TODO. Nunca en el navegador, nunca en
#                             el código, nunca en un commit.
#                             Si se filtra: Settings > API > rotar la llave.
#
# OJO al copiar: pegar sólo lo que va DESPUÉS del '='. Copiar la línea entera
# ("SUPABASE_URL=https://...") ya rompió una corrida en GitHub Actions, y el
# error salía como un ERR_INVALID_URL enterrado en un stack de undici,
# imposible de relacionar con el secreto. Por eso el workflow ahora lo valida.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# --- Discord ---------------------------------------------------------------
# Dos canales distintos a propósito: los avisos de predicciones son para leer
# con calma, un fallo hay que verlo ya. Mezclados, el error se pierde entre
# veinte mensajes de partidas.
#
# Dónde, para cada uno: en Discord, click derecho sobre el canal > Editar
# canal > Integraciones > Webhooks > Nuevo webhook > Copiar URL.
#
# Si se filtra: en esa misma pantalla, "Copiar nueva URL" invalida la vieja.
DISCORD_WEBHOOK=
DISCORD_WEBHOOK_ERRORES=


# --- Telegram ----------------------------------------------------------------
# Un solo token sirve para todos los canales (a diferencia de Discord, que
# necesita un webhook por canal). El bot lo crea @BotFather en 2 minutos.
#
#   TELEGRAM_BOT_TOKEN: el token que BotFather te da al crear el bot
#                       (formato 123456789:AAE...). Si se filtra: /revoke en
#                       BotFather genera uno nuevo.
#   TELEGRAM_CHAT_ID:   el canal al que avisa el bot. Canal público =
#                       @nombredelcanal. Privado = el número negativo que
#                       sale de getUpdates tras mandarle un mensaje.
#
# El bot debe ser ADMINISTRADOR del canal para poder publicar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Compras Stars: receptor Supabase Edge/Node, distinto del cron de avisos --
# Permanecen apagadas hasta completar docs/TELEGRAM_STARS.md.
TELEGRAM_STARS_ENABLED=false
# Precios enteros en Stars. PRO: 1..10000; dejar vacíos hasta elegir precio.
TELEGRAM_PRO_STARS=
# Vacío deshabilita compra individual. Configurarlo para activar /comprar ID.
TELEGRAM_MATCH_STARS=
# true: renovación automática cada 30 días; false: PRO con pago único 30 días.
TELEGRAM_PRO_RECURRING=true
# Contacto real del vendedor (@usuario, enlace HTTPS o email).
TELEGRAM_PAY_SUPPORT=
# Secreto aleatorio 32..256 caracteres A-Z a-z 0-9 _ -. No es el token del bot.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://TU-HOST/telegram
# Node escucha detrás del proxy HTTPS. En contenedor puede requerir 0.0.0.0.
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8787
# true requiere bot creado en el servidor TEST de Telegram y base separada.
TELEGRAM_TEST_ENV=false


# ---------------------------------------------------------------------------
# LOS MISMOS CUATRO VAN EN GITHUB ACTIONS
# ---------------------------------------------------------------------------
# Settings > Secrets and variables > Actions > New repository secret.
# Mismos nombres exactos. El .env es sólo para correr en local; el cron FREE
# corre en Actions. Los secretos del receptor Stars van en Supabase Edge,
# no en los workflows ni en los archivos del panel público.
#
# Si DISCORD_WEBHOOK_ERRORES falta, los errores caen al canal normal en vez de
# perderse: está previsto en salida/errores.mjs.
# ---------------------------------------------------------------------------
